ENV=development

# PostgreSQL (see docker-compose.yml for a local dev instance — uses the
# pgvector/pgvector image so the `vector` extension is available for SOP RAG).
# Mapped to 5433, not 5432 — avoids silently conflicting with a native/other
# Postgres a lot of dev machines already have running on the standard port.
DATABASE_URL=postgresql+asyncpg://plantwise:plantwise@localhost:5433/plantwise

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI — chat only. Embeddings deliberately do NOT use OpenAI — see
# EMBEDDING_MODEL below and app/core/llm.py.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Open-source, local embedding model (fastembed / ONNX, no API key/cost, no
# GPU required). Downloads once and is cached on disk the first time the app
# boots (see main.py's startup hook).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# SMTP (leave SMTP_HOST empty in dev to print emails to console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@plantwise.local

# Frontend origin(s), used for CORS and for links inside emails.
# Must list every scheme+host+port the frontend is actually opened from
# (only matters when ENV=production — dev mode allows any origin), or the
# browser blocks login/API calls with a CORS error. Common gotcha: prod
# preview (`npm run prod` / `python run.py prod`) serves on port 4173, not
# the dev server's 5173 — add both if you use both. If you'll reach the app
# from another device via a LAN IP, vite preview prints one "Network:" line
# per network interface on startup — each of those is a distinct origin and
# needs its own entry here too.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# ---- Production-only settings (ignored when ENV=development) ----

# Comma-separated allowed hosts, e.g. "plantwise.example.com,www.plantwise.example.com"
ALLOWED_HOSTS=

# Per-IP rate limit (applied globally as middleware)
RATE_LIMIT=100/minute

# Database connection pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Max upload size for CSV/Excel files (megabytes)
MAX_UPLOAD_SIZE_MB=50
